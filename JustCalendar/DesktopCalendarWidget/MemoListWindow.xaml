<Window x:Class="DesktopCalendarWidget.MemoListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memo List"
        Width="340" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <!-- Same flat button look as the main calendar top bar -->
        <Style x:Key="IconBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#66FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- "표시" toggle in each memo row (green when shown on the desktop) -->
        <Style x:Key="VisibleToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="#BBFFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D927AE60"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#EE1B2A4A" CornerRadius="10" BorderBrush="#66FFFFFF" BorderThickness="1">
        <DockPanel>
            <!-- TITLE BAR (drag to move) -->
            <Grid DockPanel.Dock="Top" Height="34" Background="#770D1B2A" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="📝 메모 목록" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtCount" Text="" Foreground="#99FFFFFF" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- FOOTER: Add / Delete / OK -->
            <Grid DockPanel.Dock="Bottom" Margin="10,6,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="BtnAdd" Content="＋ 추가" Height="28" Style="{StaticResource IconBtnStyle}"
                            Click="BtnAdd_Click" ToolTip="새 메모를 추가하고 바탕화면에 표시"/>
                    <Button x:Name="BtnDelete" Content="삭제" Height="28" Margin="6,0,0,0" Style="{StaticResource IconBtnStyle}"
                            Click="BtnDelete_Click" ToolTip="선택한 메모 삭제"/>
                </StackPanel>
                <Button x:Name="BtnOk" Content="확인" Height="28" HorizontalAlignment="Right" Style="{StaticResource IconBtnStyle}"
                        Background="#D93498DB" Click="BtnOk_Click"/>
            </Grid>

            <!-- MEMO ROWS -->
            <Border Margin="10,8,10,0" Background="#330D1B2A" CornerRadius="6">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MemoRows" Margin="4"/>
                    </ScrollViewer>
                    <TextBlock x:Name="TxtEmpty" Text="메모가 없습니다.&#x0a;＋ 추가 버튼으로 새 메모를 만드세요."
                               Foreground="#88FFFFFF" FontSize="12" TextAlignment="Center"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Border>
        </DockPanel>
    </Border>
</Window>
