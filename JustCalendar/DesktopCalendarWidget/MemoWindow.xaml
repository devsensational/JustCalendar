<Window x:Class="DesktopCalendarWidget.MemoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Memo" Width="260" Height="240"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        LocationChanged="Window_LocationChanged"
        SizeChanged="Window_SizeChanged">
    
    <Window.Resources>
        <Style x:Key="MiniBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="MemoBorder" Background="#E6FFF9C4" CornerRadius="6" BorderBrush="#D4C875" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" Opacity="0.35" ShadowDepth="2"/>
        </Border.Effect>
        <DockPanel>
            <!-- Memo Control Bar (Drag, Minimize, Close) -->
            <Grid x:Name="MemoTitleBar" DockPanel.Dock="Top" Height="26" Background="#CCFFE082" 
                  MouseLeftButtonDown="MemoTitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="📝 빠른 메모" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" 
                           FontWeight="SemiBold" Foreground="#5D4037"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- Minimize Toggle Button -->
                    <Button x:Name="BtnMinimize" Content="―" Style="{StaticResource MiniBtnStyle}" 
                            Foreground="#5D4037" Click="BtnMinimize_Click" ToolTip="최소화 / 펼치기"/>
                    <!-- Close Button -->
                    <Button x:Name="BtnClose" Content="✕" Style="{StaticResource MiniBtnStyle}" 
                            Foreground="#C0392B" Click="BtnClose_Click" ToolTip="메모 삭제"/>
                </StackPanel>
            </Grid>

            <!-- Text Content -->
            <TextBox x:Name="TxtMemoContent" Background="Transparent" BorderThickness="0"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     Padding="8" FontSize="12" Foreground="#2C3E50"
                     TextChanged="TxtMemoContent_TextChanged"/>
        </DockPanel>
    </Border>
</Window>