<?xml version="1.0" encoding="utf-8"?>
<!-- Small portable single exe that requires the .NET 8 Desktop Runtime to be installed -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\portable-net8\</PublishDir>
    <PortableExeName>DesktopCalendarWidget-portable-net8.exe</PortableExeName>
  </PropertyGroup>

  <!-- Remove stale files from previous publishes so only the exe remains -->
  <Target Name="CleanPortablePublishDir" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>

  <Target Name="RenamePortableExe" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(PortableExeName)" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
  </Target>
</Project>
