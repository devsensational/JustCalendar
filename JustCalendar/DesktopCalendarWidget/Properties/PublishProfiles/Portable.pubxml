<?xml version="1.0" encoding="utf-8"?>
<!-- Portable single exe including the .NET runtime (runs without .NET installed) -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Bundle WPF native DLLs (wpfgfx, PresentationNative, ...) into the exe -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Trimming is not supported for WPF -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\portable\</PublishDir>
    <PortableExeName>DesktopCalendarWidget-portable.exe</PortableExeName>
  </PropertyGroup>

  <!-- Remove stale files from previous publishes so only the exe remains -->
  <Target Name="CleanPortablePublishDir" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>

  <Target Name="RenamePortableExe" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(PortableExeName)" />
    <Delete Files="$(PublishDir)$(AssemblyName).exe" />
  </Target>
</Project>
